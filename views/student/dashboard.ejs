<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Öğrenci Paneli | Özel Ders Asistanım</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 font-sans min-h-screen pb-12">

    <!-- ÜST BİLGİ KARTI -->
    <header class="bg-blue-600 text-white p-6 rounded-b-3xl shadow-lg max-w-lg mx-auto">
        <div class="flex justify-between items-center mb-4">
            <div>
                <p class="text-blue-100 text-xs font-medium">Hoş Geldin,</p>
                <h1 class="text-2xl font-bold"><%= student.adSoyad %></h1>
            </div>
            <a href="/logout" class="bg-blue-500 hover:bg-blue-700 p-2.5 rounded-full text-white transition-colors">
                <i class="fa-solid fa-right-from-bracket"></i>
            </a>
        </div>

        <div class="grid grid-cols-2 gap-3 mt-4">
            <div class="bg-white/10 backdrop-blur-md p-3 rounded-xl flex items-center space-x-3">
                <span class="text-2xl">🥇</span>
                <div>
                    <p class="text-xs text-blue-100">Aktif Ödevler</p>
                    <p class="text-lg font-bold"><%= homeworks.length %></p>
                </div>
            </div>
            <div class="bg-white/10 backdrop-blur-md p-3 rounded-xl flex items-center space-x-3">
                <span class="text-2xl">✅</span>
                <div>
                    <p class="text-xs text-blue-100">Tamamlanan</p>
                    <p class="text-lg font-bold">0</p>
                </div>
            </div>
        </div>
    </header>

    <!-- GÖREV LİSTESİ -->
    <main class="max-w-lg mx-auto p-4 mt-4 space-y-4">
        <h2 class="text-lg font-bold text-slate-800 mb-2">Bekleyen Görevlerim</h2>

        <% if (homeworks && homeworks.length > 0) { %>
            <% homeworks.forEach(function(hw) { %>
                <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 space-y-4">
                    <div class="flex justify-between items-start">
                        <div>
                            <span class="bg-amber-100 text-amber-800 text-xs font-semibold px-2.5 py-0.5 rounded-full">
                                Son Gün: <%= hw.sonTarih || 'Belirtilmedi' %>
                            </span>
                            <h3 class="text-lg font-bold text-slate-800 mt-2"><%= hw.kitap %></h3>
                            <p class="text-sm text-slate-500"><%= hw.konu %></p>
                        </div>
                        <i class="fa-solid fa-book-open text-blue-500 text-2xl"></i>
                    </div>

                    <!-- Ödev Sonuç Formu -->
                    <form action="/ogrenci/homework-complete" method="POST" class="space-y-3 pt-2 border-t border-slate-100">
                        <input type="hidden" name="homeworkId" value="<%= hw.id %>">
                        <input type="hidden" name="studentId" value="<%= student.kursNumarasi %>">
                        
                        <div class="grid grid-cols-3 gap-2 text-center">
                            <div>
                                <label class="block text-xs font-semibold text-emerald-600 mb-1">Doğru</label>
                                <input type="number" min="0" name="dogru" required placeholder="0" class="w-full text-center py-2 bg-emerald-50 border border-emerald-200 rounded-lg text-emerald-800 font-bold outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-rose-600 mb-1">Yanlış</label>
                                <input type="number" min="0" name="yanlis" required placeholder="0" class="w-full text-center py-2 bg-rose-50 border border-rose-200 rounded-lg text-rose-800 font-bold outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-500 mb-1">Boş</label>
                                <input type="number" min="0" name="bos" required placeholder="0" class="w-full text-center py-2 bg-slate-100 border border-slate-200 rounded-lg text-slate-700 font-bold outline-none">
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Yapamadığım Soru No'lar</label>
                            <input type="text" name="yapilamayanlar" placeholder="Örn: 4, 7, 12" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm outline-none">
                        </div>

                        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 rounded-xl transition-colors shadow-md shadow-blue-100">
                            Ödevi Tamamla
                        </button>
                    </form>
                </div>
            <% }); %>
        <% } else { %>
            <div class="bg-white rounded-2xl p-8 text-center border border-slate-100 shadow-sm">
                <i class="fa-solid fa-circle-check text-4xl text-emerald-400 mb-2"></i>
                <h3 class="font-bold text-slate-800">Harika! Hiç ödevin yok.</h3>
                <p class="text-xs text-slate-500 mt-1">Öğretmenin yeni ödev atadığında burada görünecek.</p>
            </div>
        <% } %>
    </main>

</body>
</html>

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Öğrenci Paneli | Özel Ders Asistanım</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 font-sans text-slate-800">

    <!-- Üst Menü -->
    <nav class="bg-blue-600 text-white shadow-md">
        <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
            <div class="font-bold text-xl flex items-center gap-2">
                <i class="fa-solid fa-graduation-cap"></i> Asistanım
            </div>
            <a href="/ogrenci/login" class="text-blue-100 hover:text-white transition-colors text-sm font-medium">
                <i class="fa-solid fa-sign-out-alt"></i> Çıkış Yap
            </a>
        </div>
    </nav>

    <main class="max-w-6xl mx-auto px-4 py-8">
        
        <!-- Öğrenci Bilgi Kartı -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 mb-8 flex flex-col md:flex-row items-center justify-between">
            <div class="flex items-center gap-4 mb-4 md:mb-0">
                <div class="w-16 h-16 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-2xl font-bold">
                    <i class="fa-regular fa-user"></i>
                </div>
                <div>
                    <h2 class="text-2xl font-bold text-slate-800">Merhaba, <%= student.adSoyad %>!</h2>
                    <p class="text-slate-500">Sınıf: <%= student.sinif %> | Kurs No: <%= student.kursNumarasi %></p>
                </div>
            </div>
            <div class="bg-slate-100 px-5 py-3 rounded-lg border border-slate-200 text-center">
                <span class="block text-xs text-slate-500 uppercase tracking-wide font-bold">Toplam Ödev</span>
                <span class="text-2xl font-bold text-blue-600"><%= homeworks.length %></span>
            </div>
        </div>

        <!-- Ödevler Listesi Başlığı -->
        <h3 class="text-xl font-bold mb-6 flex items-center gap-2 text-slate-700">
            <i class="fa-solid fa-list-check text-blue-500"></i> Güncel Ödevlerim
        </h3>

        <!-- Ödev Kartları -->
        <% if (homeworks && homeworks.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% homeworks.forEach(hw => { %>
                    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 hover:shadow-md transition-shadow relative overflow-hidden">
                        
                        <!-- Üst Renkli Durum Çizgisi -->
                        <div class="absolute top-0 left-0 w-full h-1 <%= hw.durum === 'Tamamlandı' ? 'bg-green-500' : 'bg-amber-400' %>"></div>
                        
                        <div class="flex justify-between items-start mb-4 mt-2">
                            <!-- Durum Etiketi -->
                            <span class="px-3 py-1 rounded-md text-xs font-bold shadow-sm <%= hw.durum === 'Tamamlandı' ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700' %>">
                                <%= hw.durum %>
                            </span>
                            <!-- Son Tarih -->
                            <span class="text-xs text-slate-500 font-medium flex items-center gap-1 bg-slate-100 px-2 py-1 rounded">
                                <i class="fa-regular fa-calendar"></i> <%= hw.sonTarih %>
                            </span>
                        </div>
                        
                        <h4 class="font-bold text-lg text-slate-800 mb-1"><%= hw.kitap %></h4>
                        <p class="text-slate-600 text-sm mb-4"><%= hw.konu %></p>
                        <% if (hw.durum !== 'Tamamlandı') { %>
                            <button onclick="openResultModal('<%= hw.id %>', '<%= hw.kitap %>', '<%= hw.konu %>')" 
                                class="w-full bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white font-semibold py-2.5 rounded-lg transition-colors border border-blue-100 flex items-center justify-center gap-2 mt-2">
                                <i class="fa-solid fa-pen"></i> Sonucu Gir
                            </button>
                        <% } else if (hw.sonuclar) { %>
                            <div class="grid grid-cols-3 gap-2 mt-2 pt-4 border-t border-slate-100 text-center">
                                <div class="bg-green-50 text-green-700 py-1.5 rounded-md text-sm font-bold flex items-center justify-center gap-1">
                                    <i class="fa-solid fa-check"></i> <%= hw.sonuclar.dogru %>
                                </div>
                                <div class="bg-red-50 text-red-700 py-1.5 rounded-md text-sm font-bold flex items-center justify-center gap-1">
                                    <i class="fa-solid fa-xmark"></i> <%= hw.sonuclar.yanlis %>
                                </div>
                                <div class="bg-slate-50 text-slate-600 py-1.5 rounded-md text-sm font-bold flex items-center justify-center gap-1">
                                    <i class="fa-regular fa-circle"></i> <%= hw.sonuclar.bos %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <!-- Ödev Yoksa Çıkacak Ekran -->
            <div class="text-center py-16 bg-white rounded-xl border border-dashed border-slate-300">
                <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-slate-50 text-slate-300 mb-4">
                    <i class="fa-solid fa-mug-hot text-3xl"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-700 mb-2">Harika! Tüm görevler tamam.</h3>
                <p class="text-slate-500">Şu an için atanmış yeni bir ödevin bulunmuyor. Dinlenebilirsin.</p>
            </div>
        <% } %>

    </main>
    <!-- SONUÇ GİRME MODALI (Otomatik Hesaplamalı) -->
    <div id="resultModal" class="hidden fixed inset-0 bg-slate-900 bg-opacity-60 flex items-center justify-center z-50 px-4 backdrop-blur-sm transition-opacity">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden transform transition-all">
            <!-- Modal Başlık -->
            <div class="bg-blue-600 px-6 py-4 flex justify-between items-center text-white">
                <h3 class="font-bold text-lg flex items-center gap-2">
                    <i class="fa-solid fa-chart-pie"></i> Ödev Sonucu
                </h3>
                <button type="button" onclick="closeResultModal()" class="text-blue-100 hover:text-white transition-colors">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>
            
            <!-- Modal Form -->
            <form action="/ogrenci/odev-tamamla" method="POST" class="p-6">
                <!-- Arka planda sunucuya gidecek gizli veriler -->
                <input type="hidden" name="kursNumarasi" value="<%= student.kursNumarasi %>">
                <input type="hidden" name="odevId" id="modalOdevId">
                
                <div class="mb-5 text-sm text-slate-600 bg-slate-50 p-4 rounded-xl border border-slate-200 shadow-sm">
                    <strong id="modalKitap" class="block text-slate-800 text-base mb-1"></strong>
                    <span id="modalKonu" class="flex items-center gap-1"><i class="fa-solid fa-book-open text-blue-400"></i></span>
                </div>

                <div class="grid grid-cols-3 gap-4 mb-4">
                    <div>
                        <label class="block text-xs font-bold text-green-600 mb-2 uppercase tracking-wide text-center">Doğru</label>
                        <input type="number" id="inputDogru" name="dogru" min="0" required class="w-full bg-green-50 border border-green-200 rounded-lg px-3 py-3 text-center text-lg font-bold text-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 transition-shadow">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-red-600 mb-2 uppercase tracking-wide text-center">Yanlış</label>
                        <input type="number" id="inputYanlis" name="yanlis" min="0" required class="w-full bg-red-50 border border-red-200 rounded-lg px-3 py-3 text-center text-lg font-bold text-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 transition-shadow">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 mb-2 uppercase tracking-wide text-center">Boş</label>
                        <!-- readonly eklendi ve arka planı kilitli görünüme alındı -->
                        <input type="number" id="inputBos" name="bos" min="0" required readonly tabindex="-1" class="w-full bg-slate-200 border border-slate-300 rounded-lg px-3 py-3 text-center text-lg font-bold text-slate-500 cursor-not-allowed focus:outline-none">
                    </div>
                </div>

                <!-- Hata Mesajı Alanı (Fazla soru girilirse çıkar) -->
                <p id="errorMessage" class="hidden text-red-500 text-xs font-bold text-center mb-4 bg-red-50 py-2 rounded-lg border border-red-100"></p>

                <button type="submit" id="submitBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 rounded-xl transition-colors shadow-lg shadow-blue-200 flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                    <i class="fa-solid fa-floppy-disk"></i> Kaydet ve Tamamla
                </button>
            </form>
        </div>
    </div>

    <!-- Modal ve Canlı Hesaplama Kontrol Scripti -->
    <script>
        let toplamSoruSayisi = 0;

        function openResultModal(odevId, kitap, konu) {
            document.getElementById('modalOdevId').value = odevId;
            document.getElementById('modalKitap').innerText = kitap;
            document.getElementById('modalKonu').innerHTML = `<i class="fa-solid fa-book-open text-blue-400 mr-2"></i> ${konu}`;
            
            // Konu metninden "20" gibi soru sayısını yakalama (Örn: "Test 1 (20 Soru)")
            const soruSayisiEslestirme = konu.match(/\((\d+)\s*Soru\)/i);
            
            if (soruSayisiEslestirme && soruSayisiEslestirme[1]) {
                toplamSoruSayisi = parseInt(soruSayisiEslestirme[1]);
                document.getElementById('inputBos').value = toplamSoruSayisi; // İlk açılışta hepsi boş
            } else {
                toplamSoruSayisi = 0; 
                document.getElementById('inputBos').value = 0;
            }

            // Girdileri sıfırla
            document.getElementById('inputDogru').value = '';
            document.getElementById('inputYanlis').value = '';
            document.getElementById('errorMessage').classList.add('hidden');
            document.getElementById('submitBtn').disabled = false;

            document.getElementById('resultModal').classList.remove('hidden');
        }

        function closeResultModal() {
            document.getElementById('resultModal').classList.add('hidden');
        }

        // Doğru ve Yanlış girişlerini dinleyip Boş sayısını hesaplama
        const inputDogru = document.getElementById('inputDogru');
        const inputYanlis = document.getElementById('inputYanlis');
        const inputBos = document.getElementById('inputBos');
        const errorMessage = document.getElementById('errorMessage');
        const submitBtn = document.getElementById('submitBtn');

        function canliHesapla() {
            if (toplamSoruSayisi === 0) return; // Soru sayısı yoksa hesaplama yapma

            const dogru = parseInt(inputDogru.value) || 0;
            const yanlis = parseInt(inputYanlis.value) || 0;
            const girilenToplam = dogru + yanlis;
            const bos = toplamSoruSayisi - girilenToplam;

            if (bos < 0) {
                // Toplam sorudan fazla veri girildiyse kaydetmeyi engelle
                errorMessage.innerText = `Hata: Bu test toplam ${toplamSoruSayisi} sorudur. Fazla giriş yaptınız!`;
                errorMessage.classList.remove('hidden');
                submitBtn.disabled = true;
                inputBos.value = 0;
            } else {
                // Her şey normalse Boş kutusunu güncelle
                errorMessage.classList.add('hidden');
                submitBtn.disabled = false;
                inputBos.value = bos;
            }
        }

        // Her sayı girildiğinde veya silindiğinde tetiklenir
        inputDogru.addEventListener('input', canliHesapla);
        inputYanlis.addEventListener('input', canliHesapla);
    </script>
</body>
</html>


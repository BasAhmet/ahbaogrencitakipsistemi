<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Öğrenci Paneli | Özel Ders Asistanım</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 font-sans pb-10">

    <!-- Üst Bilgi Barı -->
    <header class="bg-blue-600 text-white shadow-md rounded-b-3xl pb-6 pt-8 px-6 mb-6">
        <div class="flex justify-between items-center mb-4">
            <div>
                <p class="text-blue-100 text-sm font-medium mb-1">Hoş Geldin,</p>
                <h1 class="text-2xl font-bold">Ahmet Yılmaz</h1>
            </div>
            <a href="/logout" class="bg-blue-700/50 hover:bg-blue-800 p-3 rounded-full transition-colors">
                <i class="fa-solid fa-sign-out-alt"></i>
            </a>
        </div>
        
        <!-- Öğrenci İstatistik Özeti -->
        <div class="flex gap-4 mt-6">
            <div class="bg-white/10 rounded-xl p-4 flex-1 backdrop-blur-sm">
                <p class="text-blue-100 text-xs mb-1">Rozetler</p>
                <p class="text-xl font-bold"><i class="fa-solid fa-medal text-yellow-300 mr-2"></i>3</p>
            </div>
            <div class="bg-white/10 rounded-xl p-4 flex-1 backdrop-blur-sm">
                <p class="text-blue-100 text-xs mb-1">Tamamlanan Ödev</p>
                <p class="text-xl font-bold"><i class="fa-solid fa-check-circle text-green-300 mr-2"></i>12</p>
            </div>
        </div>
    </header>

    <main class="px-5 space-y-6 max-w-md mx-auto">
        
        <h2 class="text-lg font-bold text-slate-800 px-1">Bekleyen Görevlerim</h2>

        <!-- Aktif Ödev Kartı -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="p-5 border-b border-slate-50">
                <div class="flex justify-between items-start mb-2">
                    <span class="bg-amber-100 text-amber-700 text-xs font-bold px-2.5 py-1 rounded-md">Son Gün: Yarın</span>
                    <i class="fa-solid fa-book text-slate-300 text-xl"></i>
                </div>
                <h3 class="font-bold text-slate-800 text-lg mb-1">LGS Matematik Soru Bankası</h3>
                <p class="text-slate-500 text-sm">Çarpanlar ve Katlar - Test 3 (20 Soru)</p>
            </div>
            
            <!-- Ödev Teslim Formu (Öğrenci dolduracak) -->
            <div class="p-5 bg-slate-50/50">
                <form action="/ogrenci/odev-teslim" method="POST" class="space-y-4">
                    <input type="hidden" name="odevId" value="ornek_odev_id">
                    
                    <div class="grid grid-cols-3 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-green-600 mb-1 text-center">Doğru</label>
                            <input type="number" name="dogru" class="w-full text-center py-2 rounded-lg border border-slate-200 focus:ring-2 focus:ring-green-400 outline-none" min="0" placeholder="0">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-red-600 mb-1 text-center">Yanlış</label>
                            <input type="number" name="yanlis" class="w-full text-center py-2 rounded-lg border border-slate-200 focus:ring-2 focus:ring-red-400 outline-none" min="0" placeholder="0">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 mb-1 text-center">Boş</label>
                            <input type="number" name="bos" class="w-full text-center py-2 rounded-lg border border-slate-200 focus:ring-2 focus:ring-slate-400 outline-none" min="0" placeholder="0">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1 mt-2">Yapamadığım Soru Numaraları (Virgülle ayırın)</label>
                        <input type="text" name="yapilamayanSorular" class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:ring-2 focus:ring-blue-400 outline-none text-sm" placeholder="Örn: 4, 7, 12">
                        <p class="text-[10px] text-slate-400 mt-1">Öğretmenimiz bir sonraki derste bu soruları çözecek.</p>
                    </div>

                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl transition-colors shadow-lg shadow-blue-200 mt-2">
                        Ödevi Tamamla
                    </button>
                </form>
            </div>
        </div>

        <!-- Önceden Tamamlanmış Örnek Ödev -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 opacity-75">
            <div class="flex justify-between items-center mb-2">
                <h3 class="font-bold text-slate-700">Üslü İfadeler - Test 1</h3>
                <span class="bg-green-100 text-green-700 text-xs font-bold px-2 py-1 rounded-md"><i class="fa-solid fa-check mr-1"></i>Bitti</span>
            </div>
            <div class="flex gap-4 text-sm mt-3 border-t border-slate-100 pt-3">
                <span class="text-green-600 font-bold">18 D</span>
                <span class="text-red-600 font-bold">1 Y</span>
                <span class="text-slate-500 font-bold">1 B</span>
            </div>
        </div>

    </main>
</body>
</html>

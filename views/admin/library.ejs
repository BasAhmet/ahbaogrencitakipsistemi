<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dijital Kitaplık | Özel Ders Asistanım</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-100 font-sans flex h-screen overflow-hidden">

    <!-- SOL MENÜ (Dashboard ile aynı) -->
    <aside class="w-64 bg-slate-800 text-white flex flex-col h-full shadow-2xl">
        <div class="p-6 text-center border-b border-slate-700">
            <i class="fa-solid fa-graduation-cap text-3xl text-blue-400 mb-2"></i>
            <h2 class="text-xl font-bold tracking-wider">Asistanım</h2>
            <p class="text-slate-400 text-xs mt-1">Öğretmen Paneli</p>
        </div>
        <nav class="flex-1 px-4 py-6 space-y-2">
            <a href="/admin/dashboard" class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-700 hover:text-white rounded-lg transition-colors">
                <i class="fa-solid fa-chart-line w-6"></i>
                <span class="font-medium">Genel Bakış</span>
            </a>
            <a href="/admin/students" class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-700 hover:text-white rounded-lg transition-colors">
                <i class="fa-solid fa-users w-6"></i>
                <span class="font-medium">Öğrenciler</span>
            </a>
            <a href="/admin/library" class="flex items-center px-4 py-3 bg-blue-600 text-white rounded-lg transition-colors">
                <i class="fa-solid fa-book w-6"></i>
                <span class="font-medium">Dijital Kitaplık</span>
            </a>
            <a href="/admin/homework" class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-700 hover:text-white rounded-lg transition-colors">
                <i class="fa-solid fa-pen-to-square w-6"></i>
                <span class="font-medium">Ödev Ata</span>
            </a>
        </nav>
    </aside>

    <!-- ANA İÇERİK -->
    <main class="flex-1 flex flex-col h-full overflow-y-auto">
        <header class="bg-white shadow-sm px-8 py-5 flex items-center justify-between">
            <h1 class="text-2xl font-bold text-slate-800">Dijital Kitaplık</h1>
            <button onclick="openBookModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg font-medium transition-colors shadow-sm flex items-center gap-2">
                <i class="fa-solid fa-plus"></i> Kaynak Ekle
            </button>
        </header>

        <div class="p-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% if (books && books.length > 0) { %>
                    <% books.forEach(book => { %>
                        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-md transition-shadow flex flex-col">
                            <div class="bg-indigo-50 px-6 py-4 border-b border-slate-100 flex flex-col gap-1">
                                <div class="flex items-center gap-2">
                                    <i class="fa-solid fa-book-open text-indigo-500"></i>
                                    <h3 class="font-bold text-slate-800"><%= book.kitapAdi %></h3>
                                </div>
                                <span class="text-xs font-semibold text-indigo-600 uppercase"><%= book.konu %></span>
                            </div>
                            <div class="p-6 flex-1">
                                <p class="text-xs font-bold text-slate-400 uppercase mb-3 border-b pb-2">İçerikteki Testler</p>
                                <ul class="space-y-2 max-h-40 overflow-y-auto pr-2 custom-scrollbar">
                                    <% if(book.testler && book.testler.length > 0) { %>
                                        <% book.testler.forEach(test => { %>
                                            <li class="text-sm text-slate-600 flex justify-between items-center bg-slate-50 px-3 py-2 rounded">
                                                <span class="font-medium flex items-center gap-2"><i class="fa-regular fa-file-lines text-slate-400 text-xs"></i> <%= test.ad %></span>
                                                <span class="bg-white px-2 py-1 rounded text-xs font-bold text-blue-600 border border-slate-200"><%= test.soru %> Soru</span>
                                            </li>
                                        <% }) %>
                                    <% } %>
                                </ul>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-span-full bg-white rounded-xl p-10 text-center border border-slate-200 text-slate-500">
                        <i class="fa-solid fa-books text-4xl text-slate-300 mb-3"></i>
                        <p>Henüz kitaplığa kaynak eklenmemiş.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <!-- YENİ KİTAP EKLEME MODALI -->
    <div id="bookModal" class="hidden fixed inset-0 bg-slate-900 bg-opacity-60 flex items-center justify-center z-50 px-4 backdrop-blur-sm">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden flex flex-col max-h-[90vh]">
            <div class="bg-blue-600 px-6 py-4 flex justify-between items-center text-white shrink-0">
                <h3 class="font-bold text-lg">Kütüphaneye Kaynak Ekle</h3>
                <button type="button" onclick="closeBookModal()" class="text-blue-100 hover:text-white"><i class="fa-solid fa-xmark text-xl"></i></button>
            </div>
            
            <form action="/admin/book-add" method="POST" class="p-6 overflow-y-auto flex-1">
                <div class="mb-4">
                    <label class="block text-sm font-bold text-slate-700 mb-2">Kitap Adı</label>
                    <input type="text" name="kitapAdi" required placeholder="Örn: 8. Sınıf Master Matematik" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div class="mb-6">
                    <label class="block text-sm font-bold text-slate-700 mb-2">Konu / Ünite Adı</label>
                    <input type="text" name="konu" required placeholder="Örn: Çarpanlar ve Katlar" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                
                <div class="mb-2 flex justify-between items-end border-b pb-2">
                    <label class="block text-sm font-bold text-slate-700">Testler ve Soru Sayıları</label>
                    <button type="button" onclick="addTestRow()" class="text-xs bg-indigo-50 text-indigo-600 font-bold px-3 py-1.5 rounded-lg hover:bg-indigo-100 transition-colors border border-indigo-100">
                        + Test Ekle
                    </button>
                </div>
                
                <div id="testContainer" class="space-y-3 mb-6">
                    <!-- Varsayılan İlk Test Satırı -->
                    <div class="flex gap-2 items-center test-row">
                        <input type="text" name="testAdlari[]" placeholder="Test Adı (Örn: Test 1)" required class="w-7/12 bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <input type="number" name="soruSayilari[]" placeholder="Soru Sayısı" required min="1" class="w-4/12 bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <div class="w-1/12 text-center text-slate-300">
                            <!-- İlk satır silinemez -->
                            <i class="fa-solid fa-lock text-xs"></i>
                        </div>
                    </div>
                </div>

                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 rounded-xl shadow-lg flex justify-center items-center gap-2 transition-colors">
                    <i class="fa-solid fa-floppy-disk"></i> Kaydet
                </button>
            </form>
        </div>
    </div>

    <script>
        function openBookModal() { document.getElementById('bookModal').classList.remove('hidden'); }
        function closeBookModal() { document.getElementById('bookModal').classList.add('hidden'); }
        
        function addTestRow() {
            const container = document.getElementById('testContainer');
            const row = document.createElement('div');
            row.className = 'flex gap-2 items-center test-row mt-3';
            row.innerHTML = `
                <input type="text" name="testAdlari[]" placeholder="Test Adı" required class="w-7/12 bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                <input type="number" name="soruSayilari[]" placeholder="Soru Sayısı" required min="1" class="w-4/12 bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                <button type="button" onclick="this.parentElement.remove()" class="w-1/12 text-red-500 hover:text-red-700 transition-colors">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
            `;
            container.appendChild(row);
        }
    </script>
</body>
</html>

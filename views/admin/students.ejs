<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Öğrenciler | Yönetim Paneli</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-100 font-sans flex h-screen overflow-hidden">

    <!-- SOL MENÜ (SIDEBAR) -->
    <aside class="w-64 bg-slate-800 text-white flex flex-col h-full shadow-2xl">
        <div class="p-6 text-center border-b border-slate-700">
            <i class="fa-solid fa-graduation-cap text-3xl text-blue-400 mb-2"></i>
            <h2 class="text-xl font-bold tracking-wider">Asistanım</h2>
            <p class="text-slate-400 text-xs mt-1">Öğretmen Paneli</p>
        </div>
        
        <nav class="flex-1 px-4 py-6 space-y-2">
            <a href="/admin/dashboard" class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-700 hover:text-white rounded-lg transition-colors">
                <i class="fa-solid fa-chart-line w-6"></i>
                <span class="font-medium ml-3">Genel Bakış</span>
            </a>
            <a href="/admin/students" class="flex items-center px-4 py-3 bg-blue-600 text-white rounded-lg transition-colors">
                <i class="fa-solid fa-users w-6"></i>
                <span class="font-medium ml-3">Öğrenciler</span>
            </a>
            <a href="#" class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-700 hover:text-white rounded-lg transition-colors">
                <i class="fa-solid fa-book w-6"></i>
                <span class="font-medium ml-3">Dijital Kitaplık</span>
            </a>
            <!-- LİNK GÜNCELLENDİ -->
            <a href="/admin/homework" class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-700 hover:text-white rounded-lg transition-colors">
                <i class="fa-solid fa-pen-to-square w-6"></i>
                <span class="font-medium ml-3">Ödev Ata</span>
            </a>
        </nav>
        
        <div class="p-4 border-t border-slate-700">
            <a href="/logout" class="flex items-center justify-center px-4 py-2 bg-red-500/10 text-red-400 hover:bg-red-500 hover:text-white rounded-lg transition-colors text-sm font-medium">
                <i class="fa-solid fa-sign-out-alt mr-2"></i> Çıkış Yap
            </a>
        </div>
    </aside>

    <!-- ANA İÇERİK ALANI -->
    <main class="flex-1 flex flex-col h-full overflow-y-auto">
        <header class="bg-white shadow-sm px-8 py-5 flex items-center justify-between">
            <h1 class="text-2xl font-bold text-slate-800">Öğrenci Yönetimi</h1>
        </header>

        <div class="p-8 space-y-6">
            <!-- YENİ ÖĞRENCİ EKLEME FORMU -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 bg-slate-50">
                    <h3 class="text-lg font-bold text-slate-800"><i class="fa-solid fa-user-plus text-blue-500 mr-2"></i>Yeni Öğrenci Ekle</h3>
                </div>
                <form action="/admin/student-add" method="POST" class="p-6">
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Ad Soyad</label>
                            <input type="text" name="adSoyad" required class="w-full px-3 py-2 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Örn: Ayşe Demir">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Seviye / Sınıf</label>
                            <input type="text" name="sinif" required class="w-full px-3 py-2 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Örn: 8. Sınıf (LGS)">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Kurs Numarası (Şifre)</label>
                            <input type="text" name="kursNumarasi" required class="w-full px-3 py-2 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Örn: 1045">
                        </div>
                        <div class="flex items-end">
                            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md transition-colors">
                                Kaydet
                            </button>
                        </div>
                    </div>
                </form>
            </div>
            
            <!-- MEVCUT ÖĞRENCİLER LİSTESİ -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                    <h3 class="text-lg font-bold text-slate-800"><i class="fa-solid fa-list-check text-blue-500 mr-2"></i>Kayıtlı Öğrenciler</h3>
                    <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-3 py-1 rounded-full"><%= students.length %> Öğrenci</span>
                </div>
                
                <div class="overflow-x-auto">
                    <% if (students && students.length > 0) { %>
                        <table class="w-full text-sm text-left text-slate-500">
                            <thead class="text-xs text-slate-700 uppercase bg-white border-b border-slate-200">
                                <tr>
                                    <th scope="col" class="px-6 py-4">Öğrenci Adı</th>
                                    <th scope="col" class="px-6 py-4">Sınıf / Seviye</th>
                                    <th scope="col" class="px-6 py-4 text-center">Şifre (Kurs No)</th>
                                    <th scope="col" class="px-6 py-4 text-center">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% students.forEach(function(student) { %>
                                    <tr class="bg-white border-b border-slate-100 hover:bg-slate-50 transition-colors">
                                        <td class="px-6 py-4 font-medium text-slate-900 whitespace-nowrap">
                                            <div class="flex items-center">
                                                <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold mr-3 shadow-sm">
                                                    <%= student.adSoyad.charAt(0).toUpperCase() %>
                                                </div>
                                                <%= student.adSoyad %>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="bg-slate-100 text-slate-700 px-2 py-1 rounded text-xs font-medium border border-slate-200"><%= student.sinif %></span>
                                        </td>
                                        <td class="px-6 py-4 text-center font-mono text-slate-700">
                                            <%= student.kursNumarasi %>
                                        </td>
                                        
                                        <!-- YENİ İŞLEMLER ALANI -->
                                        <td class="px-6 py-4">
                                            <div class="flex items-center justify-center space-x-3">
                                                <!-- SİHİRLİ KISAYOL BUTONU BURADA -->
                                                <a href="/admin/homework?ogrenciId=<%= student.kursNumarasi %>" 
                                                   class="bg-blue-100 text-blue-700 hover:bg-blue-200 px-3 py-1.5 rounded-md text-xs font-semibold transition-colors flex items-center shadow-sm">
                                                    <i class="fa-solid fa-pen-to-square mr-1"></i> Ödev Ver
                                                </a>
                                                
                                                <button class="text-slate-400 hover:text-blue-600 transition-colors" title="Profili Görüntüle"><i class="fa-solid fa-eye"></i></button>
                                                <a href="/admin/student-delete/<%= student.id %>" onclick="return confirm('<%= student.adSoyad %> isimli öğrenciyi sistemden silmek istediğinize emin misiniz?')" class="text-slate-400 hover:text-red-600 transition-colors" title="Sil">
                                                <i class="fa-solid fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                        <!-- İŞLEMLER ALANI BİTİŞ -->
                                        
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <!-- Hiç Öğrenci Yoksa -->
                        <div class="p-6 text-center text-slate-500 py-12">
                            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-100 mb-4">
                                <i class="fa-solid fa-users-slash text-2xl text-slate-400"></i>
                            </div>
                            <h3 class="text-lg font-medium text-slate-900 mb-1">Henüz Öğrenci Eklenmemiş</h3>
                            <p>Yukarıdaki formu kullanarak ilk öğrencinizi sisteme kaydedebilirsiniz.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

</body>
</html>

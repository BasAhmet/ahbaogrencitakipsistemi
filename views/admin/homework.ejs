<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ödev Ata | Yönetim Paneli</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-100 font-sans flex h-screen overflow-hidden">

    <!-- SOL MENÜ -->
    <aside class="w-64 bg-slate-800 text-white flex flex-col h-full shadow-2xl">
        <div class="p-6 text-center border-b border-slate-700">
            <i class="fa-solid fa-graduation-cap text-3xl text-blue-400 mb-2"></i>
            <h2 class="text-xl font-bold tracking-wider">Asistanım</h2>
            <p class="text-slate-400 text-xs mt-1">Öğretmen Paneli</p>
        </div>
        <nav class="flex-1 px-4 py-6 space-y-2">
            <a href="/admin/dashboard" class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-700 rounded-lg transition-colors">
                <i class="fa-solid fa-chart-line w-6"></i><span class="font-medium ml-3">Genel Bakış</span>
            </a>
            <a href="/admin/students" class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-700 rounded-lg transition-colors">
                <i class="fa-solid fa-users w-6"></i><span class="font-medium ml-3">Öğrenciler</span>
            </a>
            <a href="/admin/library" class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-700 hover:text-white rounded-lg transition-colors">
                <i class="fa-solid fa-book w-6"></i>
                <span class="font-medium ml-3">Dijital Kitaplık</span>
            </a>
            <a href="/admin/homework" class="flex items-center px-4 py-3 bg-blue-600 text-white rounded-lg transition-colors">
                <i class="fa-solid fa-pen-to-square w-6"></i><span class="font-medium ml-3">Ödev Ata</span>
            </a>
        </nav>
        <div class="p-4 border-t border-slate-700">
            <a href="/logout" class="flex items-center justify-center px-4 py-2 bg-red-500/10 text-red-400 hover:bg-red-500 hover:text-white rounded-lg transition-colors text-sm font-medium">
                <i class="fa-solid fa-sign-out-alt mr-2"></i> Çıkış Yap
            </a>
        </div>
    </aside>

        <!-- ANA İÇERİK -->
    <main class="flex-1 flex flex-col h-full overflow-y-auto">
        <header class="bg-white shadow-sm px-8 py-5">
            <h1 class="text-2xl font-bold text-slate-800">Yeni Ödev Ata</h1>
            <p class="text-sm text-slate-500 mt-1">Öğrencilerinize dijital kitaplığınızdan hızlıca ödev atayın.</p>
        </header>

        <div class="p-8 flex justify-center">
            <form action="/admin/homework-add" method="POST" class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 w-full max-w-2xl">
                
                <!-- Öğrenci Seçimi -->
                <div class="mb-6">
                    <label class="block text-sm font-bold text-slate-700 mb-2">Öğrenci Seçin</label>
                    <select name="ogrenciId" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-700">
                        <option value="">-- Listeden Öğrenci Seçin --</option>
                        <% students.forEach(student => { %>
                            <option value="<%= student.kursNumarasi %>"><%= student.adSoyad %> (Kurs No: <%= student.kursNumarasi %>)</option>
                        <% }) %>
                    </select>
                </div>

                <!-- Kaynak (Kitap + Ünite) Seçimi -->
                <div class="mb-6">
                    <label class="block text-sm font-bold text-slate-700 mb-2">Kaynak (Kitap ve Ünite)</label>
                    <select id="kaynakSelect" name="kitap" onchange="updateTests()" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-700">
                        <option value="">-- Dijital Kitaplıktan Seçin --</option>
                        <% books.forEach(book => { %>
                            <!-- data-id ile kitabı JS'te bulabilmek için işaretliyoruz -->
                            <option value="<%= book.kitapAdi %> - <%= book.konu %>" data-id="<%= book.id %>">
                                <%= book.kitapAdi %> (<%= book.konu %>)
                            </option>
                        <% }) %>
                    </select>
                </div>

                <!-- Test Seçimi (Otomatik Dolacak) -->
                <div class="mb-6">
                    <label class="block text-sm font-bold text-slate-700 mb-2">Test Seçimi</label>
                    <select id="testSelect" name="konu" required disabled class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-700 disabled:opacity-50 disabled:cursor-not-allowed transition-all">
                        <option value="">Önce yukarıdan bir kaynak seçmelisiniz</option>
                    </select>
                </div>

                <!-- Son Teslim Tarihi -->
                <div class="mb-8">
                    <label class="block text-sm font-bold text-slate-700 mb-2">Son Teslim Tarihi</label>
                    <input type="date" name="sonTarih" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-700">
                </div>

                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 rounded-xl shadow-lg transition-colors flex justify-center items-center gap-2 text-lg">
                    <i class="fa-solid fa-paper-plane"></i> Ödevi Gönder
                </button>
            </form>
        </div>
    </main>

    <!-- DİNAMİK DROPDOWN (AÇILIR MENÜ) KONTROLÜ -->
    <script>
        // Sunucudan gelen kitap verilerini JS'in anlayabileceği formata (JSON) çeviriyoruz
        const libraryBooks = <%- JSON.stringify(books || []) %>;

        function updateTests() {
            const kaynakSelect = document.getElementById('kaynakSelect');
            const testSelect = document.getElementById('testSelect');
            
            // Seçilen seçeneğin (option) data-id değerini alıyoruz
            const selectedOption = kaynakSelect.options[kaynakSelect.selectedIndex];
            const selectedId = selectedOption.getAttribute('data-id');

            // Test menüsünü sıfırla
            testSelect.innerHTML = '<option value="">-- Test Seçin --</option>';
            
            if (!selectedId) {
                testSelect.disabled = true;
                return;
            }

            // Seçilen kitabı ID'sinden bul
            const selectedBook = libraryBooks.find(b => b.id === selectedId);

            if (selectedBook && selectedBook.testler && selectedBook.testler.length > 0) {
                testSelect.disabled = false; // Test menüsünü aktifleştir
                
                // Kitaptaki testleri tek tek menüye ekle
                selectedBook.testler.forEach(test => {
                    const option = document.createElement('option');
                    // Veritabanına "Test 1 (20 Soru)" şeklinde kaydolmasını sağlıyoruz
                    option.value = `${test.ad} (${test.soru} Soru)`; 
                    option.textContent = `${test.ad} - ${test.soru} Soru`;
                    testSelect.appendChild(option);
                });
            } else {
                testSelect.disabled = true;
                testSelect.innerHTML = '<option value="">Bu kaynakta test bulunamadı</option>';
            }
        }
    </script>
</body>
</html>

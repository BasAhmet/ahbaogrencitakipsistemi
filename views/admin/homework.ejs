<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ödev Ata | Yönetim Paneli</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-100 font-sans flex h-screen overflow-hidden">

    <!-- SOL MENÜ -->
    <aside class="w-64 bg-slate-800 text-white flex flex-col h-full shadow-2xl">
        <div class="p-6 text-center border-b border-slate-700">
            <i class="fa-solid fa-graduation-cap text-3xl text-blue-400 mb-2"></i>
            <h2 class="text-xl font-bold tracking-wider">Asistanım</h2>
            <p class="text-slate-400 text-xs mt-1">Öğretmen Paneli</p>
        </div>
        <nav class="flex-1 px-4 py-6 space-y-2">
            <a href="/admin/dashboard" class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-700 rounded-lg transition-colors">
                <i class="fa-solid fa-chart-line w-6"></i><span class="font-medium ml-3">Genel Bakış</span>
            </a>
            <a href="/admin/students" class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-700 rounded-lg transition-colors">
                <i class="fa-solid fa-users w-6"></i><span class="font-medium ml-3">Öğrenciler</span>
            </a>
            <a href="/admin/homework" class="flex items-center px-4 py-3 bg-blue-600 text-white rounded-lg transition-colors">
                <i class="fa-solid fa-pen-to-square w-6"></i><span class="font-medium ml-3">Ödev Ata</span>
            </a>
        </nav>
        <div class="p-4 border-t border-slate-700">
            <a href="/logout" class="flex items-center justify-center px-4 py-2 bg-red-500/10 text-red-400 hover:bg-red-500 hover:text-white rounded-lg transition-colors text-sm font-medium">
                <i class="fa-solid fa-sign-out-alt mr-2"></i> Çıkış Yap
            </a>
        </div>
    </aside>

    <!-- ANA İÇERİK -->
    <main class="flex-1 flex flex-col h-full overflow-y-auto">
        <header class="bg-white shadow-sm px-8 py-5">
            <h1 class="text-2xl font-bold text-slate-800">Yeni Ödev Ata</h1>
        </header>

        <div class="p-8">
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6 max-w-3xl">
                <form action="/admin/homework-add" method="POST" class="space-y-6">
                    
                    <!-- Öğrenci Seçimi -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-2">Öğrenci Seçin</label>
                        <select name="ogrenciId" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                            <option value="">Lütfen listeden bir öğrenci seçin...</option>
                            <% if (students && students.length > 0) { %>
                                <% students.forEach(function(student) { %>
                                    <option value="<%= student.kursNumarasi %>"><%= student.adSoyad %> (<%= student.sinif %>)</option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Kaynak/Kitap -->
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-2">Kaynak / Kitap Adı</label>
                            <input type="text" name="kitap" required placeholder="Örn: LGS Soru Bankası" 
                                class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                        </div>
                        
                        <!-- Konu/Test -->
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-2">Konu ve Test No</label>
                            <input type="text" name="konu" required placeholder="Örn: Üslü İfadeler - Test 4" 
                                class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                        </div>
                    </div>

                    <!-- Teslim Tarihi -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-2">Son Teslim Günü (Opsiyonel)</label>
                        <input type="text" name="sonTarih" placeholder="Örn: Yarın, Cuma, 12 Kasım vb." 
                            class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                    </div>

                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-lg transition-colors shadow-lg shadow-blue-200 mt-4">
                        <i class="fa-solid fa-paper-plane mr-2"></i> Ödevi Öğrenciye Gönder
                    </button>
                </form>
            </div>
        </div>
    </main>

</body>
</html>

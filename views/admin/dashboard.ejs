<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yönetim Paneli | Özel Ders Asistanım</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-100 font-sans flex h-screen overflow-hidden">

    <!-- SOL MENÜ (SIDEBAR) -->
    <aside class="w-64 bg-slate-800 text-white flex flex-col h-full shadow-2xl">
        <div class="p-6 text-center border-b border-slate-700">
            <i class="fa-solid fa-graduation-cap text-3xl text-blue-400 mb-2"></i>
            <h2 class="text-xl font-bold tracking-wider">Asistanım</h2>
            <p class="text-slate-400 text-xs mt-1">Öğretmen Paneli</p>
        </div>
        
        <nav class="flex-1 px-4 py-6 space-y-2">
            <a href="/admin/dashboard" class="flex items-center px-4 py-3 bg-blue-600 text-white rounded-lg transition-colors">
                <i class="fa-solid fa-chart-line w-6"></i>
                <span class="font-medium">Genel Bakış</span>
            </a>
            <a href="/admin/students" class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-700 hover:text-white rounded-lg transition-colors">
                <i class="fa-solid fa-users w-6"></i>
                <span class="font-medium">Öğrenciler</span>
            </a>
            <a href="#" class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-700 hover:text-white rounded-lg transition-colors">
                <i class="fa-solid fa-book w-6"></i>
                <span class="font-medium">Dijital Kitaplık</span>
            </a>
            <!-- LİNK GÜNCELLENDİ -->
            <a href="/admin/homework" class="flex items-center px-4 py-3 text-slate-300 hover:bg-slate-700 hover:text-white rounded-lg transition-colors">
                <i class="fa-solid fa-pen-to-square w-6"></i>
                <span class="font-medium">Ödev Ata</span>
            </a>
        </nav>
        
        <div class="p-4 border-t border-slate-700">
            <a href="/logout" class="flex items-center justify-center px-4 py-2 bg-red-500/10 text-red-400 hover:bg-red-500 hover:text-white rounded-lg transition-colors text-sm font-medium">
                <i class="fa-solid fa-sign-out-alt mr-2"></i> Çıkış Yap
            </a>
        </div>
    </aside>

    <!-- ANA İÇERİK ALANI -->
    <main class="flex-1 flex flex-col h-full overflow-y-auto">
        
        <!-- Üst Bar -->
        <header class="bg-white shadow-sm px-8 py-5 flex items-center justify-between">
            <h1 class="text-2xl font-bold text-slate-800">Genel Bakış</h1>
            <div class="flex items-center space-x-4">
                <span class="text-sm font-medium text-slate-600">Hoş Geldiniz, Öğretmenim</span>
                <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold border-2 border-blue-200">
                    Ö
                </div>
            </div>
        </header>

        <!-- İçerik -->
        <div class="p-8 space-y-6">
            
            <!-- İstatistik Kartları -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Kart 1 -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6 flex items-center">
                    <div class="w-14 h-14 rounded-full bg-blue-50 flex items-center justify-center text-blue-500 text-2xl mr-4">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-slate-500">Kayıtlı Öğrenci</p>
                        <h3 class="text-2xl font-bold text-slate-800">12</h3>
                    </div>
                </div>
                <!-- Kart 2 -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6 flex items-center">
                    <div class="w-14 h-14 rounded-full bg-amber-50 flex items-center justify-center text-amber-500 text-2xl mr-4">
                        <i class="fa-solid fa-clock"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-slate-500">Bekleyen Ödev</p>
                        <h3 class="text-2xl font-bold text-slate-800">5</h3>
                    </div>
                </div>
                <!-- Kart 3 (En Önemlisi) -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6 flex items-center">
                    <div class="w-14 h-14 rounded-full bg-red-50 flex items-center justify-center text-red-500 text-2xl mr-4">
                        <i class="fa-solid fa-circle-question"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-slate-500">Çözülecek Sorular</p>
                        <h3 class="text-2xl font-bold text-slate-800">8</h3>
                    </div>
                </div>
            </div>

            <!-- Son Ödevler Tablosu -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
                <div class="px-6 py-5 border-b border-slate-100 flex justify-between items-center">
                    <h3 class="text-lg font-bold text-slate-800">Son Atanan Ödevler</h3>
                    <!-- LİNK GÜNCELLENDİ (Button yerine a etiketi yapıldı) -->
                    <a href="/admin/homework" class="text-sm bg-blue-50 text-blue-600 hover:bg-blue-100 px-4 py-2 rounded-md font-medium transition-colors">
                        + Yeni Ödev Ata
                    </a>
                </div>
                
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 text-slate-500 text-sm border-b border-slate-200">
                                <th class="px-6 py-4 font-medium">Öğrenci</th>
                                <th class="px-6 py-4 font-medium">Kaynak & Konu</th>
                                <th class="px-6 py-4 font-medium">Durum</th>
                                <th class="px-6 py-4 font-medium">İşlem</th>
                            </tr>
                        </thead>
                        <tbody class="text-sm">
                        <!-- Örnek Satır 1 (Tamamlanmış Ödev) -->
                        <tr class="border-b border-slate-50 hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 font-medium text-slate-800">Ali Yılmaz</td>
                            <td class="px-6 py-4">
                                <div class="text-slate-800">LGS Soru Bankası</div>
                                <div class="text-slate-500 text-xs">Çarpanlar ve Katlar - Test 2</div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                    Tamamlandı
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <!-- İNCELE BUTONU BURADA GÜNCELLENDİ -->
                                <button onclick="openReviewModal('Ali Yılmaz', 'LGS Soru Bankası', 'Çarpanlar ve Katlar - Test 2', 'Tamamlandı', 15, 3, 2)" 
                                    class="text-blue-600 hover:text-blue-800 font-medium flex items-center gap-1">
                                    İncele <i class="fa-solid fa-arrow-right-long text-xs"></i>
                                </button>
                            </td>
                        </tr>
                        <!-- Örnek Satır 2 (Bekleyen Ödev) -->
                        <tr class="border-b border-slate-50 hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 font-medium text-slate-800">Zeynep Kaya</td>
                            <td class="px-6 py-4">
                                <div class="text-slate-800">8. Sınıf Branş Denemesi</div>
                                <div class="text-slate-500 text-xs">Üslü İfadeler - Deneme 1</div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                                    Bekliyor
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <!-- BEKLEYEN ÖDEV İÇİN İNCELE BUTONU -->
                                <button onclick="openReviewModal('Zeynep Kaya', '8. Sınıf Branş Denemesi', 'Üslü İfadeler - Deneme 1', 'Bekliyor', 0, 0, 0)" 
                                    class="text-blue-600 hover:text-blue-800 font-medium flex items-center gap-1">
                                    İncele <i class="fa-solid fa-arrow-right-long text-xs"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                    </table>
                </div>
            </div>

        </div>
    </main>
<!-- ÖĞRETMEN İNCELEME MODALI -->
    <div id="reviewModal" class="hidden fixed inset-0 bg-slate-900 bg-opacity-60 flex items-center justify-center z-50 px-4 backdrop-blur-sm transition-opacity">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
            <!-- Başlık -->
            <div class="bg-indigo-600 px-6 py-4 flex justify-between items-center text-white">
                <h3 class="font-bold text-lg flex items-center gap-2">
                    <i class="fa-solid fa-magnifying-glass-chart"></i> Ödev Raporu
                </h3>
                <button onclick="closeReviewModal()" class="text-indigo-100 hover:text-white transition-colors">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>
            
            <div class="p-6">
                <!-- Ödev Detayları -->
                <div class="mb-6 pb-4 border-b border-slate-100">
                    <h4 id="revOgrenci" class="text-lg font-bold text-slate-800 mb-2">Öğrenci Adı</h4>
                    <div class="text-sm text-slate-600 flex items-start gap-2 mb-1">
                        <i class="fa-solid fa-book mt-1 text-indigo-400"></i>
                        <span id="revKitap"></span>
                    </div>
                    <div class="text-sm text-slate-600 flex items-start gap-2">
                        <i class="fa-solid fa-list-check mt-1 text-indigo-400"></i>
                        <span id="revKonu"></span>
                    </div>
                </div>

                <!-- Sonuç Alanı (Ödev tamamlandıysa gösterilecek) -->
                <div id="completedStats" class="hidden">
                    <div class="grid grid-cols-3 gap-4 mb-6 text-center">
                        <div class="bg-green-50 rounded-xl p-3 border border-green-100">
                            <span class="block text-xs font-bold text-green-600 uppercase mb-1">Doğru</span>
                            <span id="revDogru" class="text-2xl font-black text-green-700">0</span>
                        </div>
                        <div class="bg-red-50 rounded-xl p-3 border border-red-100">
                            <span class="block text-xs font-bold text-red-600 uppercase mb-1">Yanlış</span>
                            <span id="revYanlis" class="text-2xl font-black text-red-700">0</span>
                        </div>
                        <div class="bg-slate-50 rounded-xl p-3 border border-slate-200">
                            <span class="block text-xs font-bold text-slate-500 uppercase mb-1">Boş</span>
                            <span id="revBos" class="text-2xl font-black text-slate-700">0</span>
                        </div>
                    </div>
                    
                    <!-- Başarı Oranı Çubuğu -->
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="font-semibold text-slate-700">Başarı Oranı</span>
                            <span id="revYuzde" class="font-bold text-indigo-600">%0</span>
                        </div>
                        <div class="w-full bg-slate-100 rounded-full h-2.5">
                            <div id="revBar" class="bg-indigo-600 h-2.5 rounded-full" style="width: 0%"></div>
                        </div>
                    </div>
                </div>

                <!-- Bekleyen Ödev Uyarısı (Tamamlanmadıysa gösterilecek) -->
                <div id="pendingWarning" class="hidden text-center py-6">
                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-amber-100 text-amber-500 mb-4">
                        <i class="fa-regular fa-clock text-3xl"></i>
                    </div>
                    <h5 class="text-lg font-bold text-slate-800">Henüz Tamamlanmadı</h5>
                    <p class="text-slate-500 text-sm mt-1">Öğrenci bu ödevin sonuçlarını sisteme henüz girmemiş.</p>
                </div>
            </div>
            
            <div class="px-6 py-4 bg-slate-50 text-right">
                <button onclick="closeReviewModal()" class="px-5 py-2 bg-white border border-slate-200 text-slate-700 rounded-lg font-medium hover:bg-slate-100 transition-colors shadow-sm">
                    Kapat
                </button>
            </div>
        </div>
    </div>

    <!-- Modal Kontrol Scripti -->
    <script>
        function openReviewModal(ogrenci, kitap, konu, durum, dogru, yanlis, bos) {
            // Verileri doldur
            document.getElementById('revOgrenci').innerText = ogrenci || 'Bilinmiyor';
            document.getElementById('revKitap').innerText = kitap;
            document.getElementById('revKonu').innerText = konu;

            const completedStats = document.getElementById('completedStats');
            const pendingWarning = document.getElementById('pendingWarning');

            if (durum === 'Tamamlandı') {
                // Rakamları yazdır
                document.getElementById('revDogru').innerText = dogru;
                document.getElementById('revYanlis').innerText = yanlis;
                document.getElementById('revBos').innerText = bos;

                // Başarı Yüzdesi Hesaplama
                const toplamSoru = parseInt(dogru) + parseInt(yanlis) + parseInt(bos);
                let yuzde = 0;
                if (toplamSoru > 0) {
                    yuzde = Math.round((parseInt(dogru) / toplamSoru) * 100);
                }
                
                document.getElementById('revYuzde').innerText = '%' + yuzde;
                document.getElementById('revBar').style.width = yuzde + '%';

                // Görünümleri ayarla
                completedStats.classList.remove('hidden');
                pendingWarning.classList.add('hidden');
            } else {
                completedStats.classList.add('hidden');
                pendingWarning.classList.remove('hidden');
            }

            document.getElementById('reviewModal').classList.remove('hidden');
        }

        function closeReviewModal() {
            document.getElementById('reviewModal').classList.add('hidden');
        }
    </script>
</body>
</html>
